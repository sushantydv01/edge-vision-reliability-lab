# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Profiling & temporary outputs
*.prof
*.pstats

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Environment variables & secrets
.env
.env.*
!.env.example

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & editors
.idea/
.vscode/
*.swp
*.swo

# Datasets (raw and processed data should not be committed)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model weights and serialized checkpoints (heavy binaries ignored)
models/*
!models/.gitkeep
*.pt
experiments/*
!experiments/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Large temporary generated artifacts and cache dumps
artifacts/*
!artifacts/.gitkeep

# Logs and tracking directories
*.log
runs/
wandb/

# Note: reports/figures and reports/experiment_results (CSV/JSON/figures)
# are explicitly tracked to maintain reproducibility and report history.
